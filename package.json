{
  "name": "contract",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.10.0 <23"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:node": "hardhat test nodejs",
    "lint": "bash scripts/typecheck-baseline.sh",
    "lint:full": "tsc --noEmit",
    "coverage": "hardhat --coverage test nodejs",
    "size": "node scripts/check-bytecode-size.mjs",
    "verify:ci": "npm run lint && npm run compile && npm test && npm run coverage && npm run size",
    "verify": "npx tsx scripts/verify-manual.ts",
    "verify:celo": "npx tsx scripts/verify-manual.ts --network celoSepolia",
    "verify:base": "npx tsx scripts/verify-manual.ts --network baseSepolia",
    "verify:sepolia": "npx tsx scripts/verify-manual.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.3",
    "@nomicfoundation/hardhat-keystore": "^3.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.2",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.2",
    "@types/chai": "^5.2.2",
    "@types/node": "^22.18.11",
    "chai": "^6.0.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.6",
    "typescript": "~5.8.0",
    "viem": "^2.37.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
