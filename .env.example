# Never commit a production key or RPC endpoint.
DEPLOYER_PRIVATE_KEY=
CELO_MAINNET_RPC=
BASE_MAINNET_RPC=

# Distinct production addresses, managed outside this repository.
CONTRACT_ADMIN=
FEE_RECIPIENT=
ELIGIBILITY_SIGNER=
RECEIPT_URI=

# All values are seconds. Defaults are 86400, 86400, and 3600 respectively.
ROLE_TRANSFER_DELAY_SECONDS=86400
GOVERNANCE_EXECUTION_DELAY_SECONDS=86400
GOVERNANCE_CHALLENGE_PERIOD_SECONDS=3600
